rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isApprovedUser() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    function isAgency() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agency';
    }

    // Users collection - users can read/write their own data, admins can read all. Reading basic profiles is allowed for any authenticated user.
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || (isAdmin() && request.auth.uid != userId);
      allow create: if request.auth != null && request.auth.uid == userId;

      // Allow users to read and write to their own subcollections (e.g. transactions)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // FCM tokens collection
    match /fcm_tokens/{tokenId} {
      allow read, write: if isAuthenticated();
    }

    // User FCM tokens collection
    match /user_fcm_tokens/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Reviews collection - public read, authenticated create
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Destination stories - public read, admin write
    match /destination_stories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin collection
    match /admin/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Listings collection - authenticated users can read approved listings, agencies can manage their own, admins can manage all
    match /listings/{listingId} {
      allow read: if resource == null || resource.data.approved == true || (isAuthenticated() && (resource.data.agencyId == request.auth.uid || isAdmin()));
      allow write: if isAdmin() ||
                      (isAgency() && resource.data.agencyId == request.auth.uid) ||
                      (request.auth != null && !exists(/databases/$(database)/documents/listings/$(listingId)));
      allow create: if isApprovedUser() && request.auth.uid == request.resource.data.agencyId ||
                      request.auth.uid == "temp-admin-uid"; // Temporary for testing
    }

    // Chat messages - users can read/write messages they're involved in, admins can read all
    match /chat_messages/{messageId} {
      allow read: if isAdmin() || (isAuthenticated() &&
                     (request.auth.uid == resource.data.from_user_id ||
                      request.auth.uid == resource.data.to_user_id));
      allow write: if isAuthenticated() &&
                      (request.auth.uid == resource.data.from_user_id ||
                       request.auth.uid == resource.data.to_user_id);
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.from_user_id;
    }

    // Messages collection - authenticated users can read/write messages they're involved in, admins can read all
    match /messages/{messageId} {
      allow read: if isAdmin() || (isAuthenticated() &&
                     (request.auth.uid == resource.data.sender ||
                      request.auth.uid == resource.data.receiverId));
      allow write: if isAuthenticated() &&
                      (request.auth.uid == resource.data.sender ||
                       request.auth.uid == resource.data.receiverId);
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.sender;
    }

    // Bookings collection - users can create bookings, agencies can read their own bookings, admins can read all
    match /bookings/{bookingId} {
      allow read: if isAdmin() ||
                     (isAgency() && resource.data.agencyId == request.auth.uid) ||
                     (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow write: if isAdmin() ||
                      (isAgency() && resource.data.agencyId == request.auth.uid);
    }

    // Support tickets - users can create and read their own tickets, admins can read/write all
    match /support_tickets/{ticketId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow write: if isAdmin();
    }

    // Settings collection - any user can read, admins can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons collection - authenticated users can read to validate coupons, admins can write
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Blog posts collection
    // - Anyone can read published blogs (for SEO, public access)
    // - Only the blog admin (tripdm26@gmail.com) can write, create, update, delete
    match /blogs/{blogId} {
      allow read: if resource == null || resource.data.published == true || (request.auth != null && (request.auth.token.email == 'tripdm26@gmail.com' || isAdmin()));
      allow write: if request.auth != null && (request.auth.token.email == 'tripdm26@gmail.com' || isAdmin());
    }

    // Blog comments collection
    // - Anyone can read approved comments
    // - Public can submit new comments (validated server-side or client)
    // - Allow updating likes counter
    // - Only admins can modify or delete all fields
    match /blog_comments/{commentId} {
      allow read: if resource == null || resource.data.approved == true || isAdmin();
      allow create: if request.resource.data.name is string &&
                      request.resource.data.comment is string &&
                      request.resource.data.blogSlug is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) || isAdmin();
      allow delete: if isAdmin();
    }

    // Allow read access to public data for authenticated users
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; // Deny all other writes by default
    }
  }
}
